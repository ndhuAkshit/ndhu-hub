# ==============================================================================
# .gitignore - NDHU Hub Web Application
# Standard ignore configuration for client-side web development
# ==============================================================================

# Operating System Files
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msm
*.msp

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# Node & Package Managers
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/
.npm/

# Environment Variables & Sensitive Credentials
.env
.env.development.local
.env.test.local
.env.production.local
.env.local
*.env
*.pem
*.key
*.cert
*.p12
*.pfx

# IDEs & Code Editors
.vscode/
.idea/
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*.swn
*~
*.bak

# Temporary Files, Logs & Caches
*.log
logs/
tmp/
temp/
*.tmp
*.temp
.cache/
.parcel-cache/
.eslintcache/
.stylelintcache/

# Local Testing & Scratch Files
scratch/
test-results/
coverage/
